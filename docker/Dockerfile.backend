FROM python:3.11-slim

# Instalar wget para healthcheck e dependências
RUN apt-get update && apt-get install -y --no-install-recommends wget curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Criar diretório de storage antes de qualquer operação que use o banco
RUN mkdir -p /storage

# SAFE2-C3: a imagem instala sob o mesmo conjunto conhecido-verde do CI. Sem o
# constraints, `>=` resolveria na data do build e a imagem que vai ao piloto
# seria outro software — nao o que a regressao aprovou.
COPY backend/requirements.txt backend/constraints.txt ./
RUN pip install --no-cache-dir -r requirements.txt -c constraints.txt

COPY backend/ ./

# SAFE2-A: DATABASE_URL e JWT_SECRET NAO tem valor aqui, de proposito.
#
# ENV DATABASE_URL apontava para /storage/app.db, que o compose monta a partir do
# ./storage do host — a mesma pasta do banco historico protegido.
# ENV JWT_SECRET trazia um segredo publicado; por estar assado na imagem,
# esquecer a variavel no compose nao gerava falha: o servico subia assinando
# sessoes com um valor que qualquer leitor do repositorio conhece.
#
# As duas passam a vir do ambiente, e a ausencia falha alto no startup.
ENV STORAGE_PATH=/storage
ENV PORT=8000

# Expõe porta do backend (não 80)
EXPOSE 8000

# Healthcheck interno será feito pelo compose via wget, mas também define aqui para standalone
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=10s \
  CMD wget -qO- http://localhost:8000/api/health || exit 1

# SAFE2-A: `alembic upgrade head` saiu do CMD. Migrar deixou de ser efeito
# colateral de `docker compose up` e passou a ser ato operacional deliberado,
# executado contra um banco escolhido:
#   docker compose run --rm backend alembic -x database_url=<url> upgrade head
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
