# Stage 1 — build
# SAFE2-C3: Node 22 para casar com o CI, que ja roda `npm run build` nesta major
# todo ciclo. Quem estava sem prova era o Node 20 desta imagem.
FROM node:22-alpine AS builder
WORKDIR /app
# Sem o glob `*`: o lockfile passa a ser obrigatorio. Antes, um build sem ele
# seguia adiante em silencio e resolvia versoes por conta propria.
COPY frontend/package.json frontend/package-lock.json ./
# `npm ci` respeita o lockfile; `npm install` podia reescreve-lo dentro da imagem.
RUN npm ci
COPY frontend/ ./
# VITE_API_BASE_URL será injetado no build; permite override via ARG
ARG VITE_API_BASE_URL=http://localhost:8000/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# Stage 2 — serve com nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# Configuração nginx para SPA (fallback para index.html) e escuta em 8080
RUN printf 'server {\n  listen 8080;\n  server_name _;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n  # opcional: proxy /api para backend se quiser, mas frontend chama backend direto via VITE_API_BASE_URL\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
# nginx health: verifica se serve index.
#
# ENV-1: era `localhost`, e o contêiner ficava PERMANENTEMENTE unhealthy. Dentro
# da imagem, `localhost` resolve `::1` antes de `127.0.0.1`, o nginx desta config
# escuta so IPv4, e o wget do busybox nao tenta a outra familia — ao contrario do
# wget GNU do backend (debian), que cai para IPv4 e por isso nunca exibiu o
# problema. O servico sempre serviu corretamente; quem estava quebrado era a
# medicao. Sem isto, o passo VERIFY HEALTH do runbook nasceria sem significado.
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
