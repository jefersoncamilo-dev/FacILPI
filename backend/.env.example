# Copie para .env e preencha — nunca comite .env real
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
# Para Supabase/Postgres: postgresql+asyncpg://user:password@host:port/database?pgbouncer=true
JWT_SECRET=troque-este-segredo-em-producao-com-32-caracteres-minimo
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
PORT=8000
STORAGE_PATH=./storage
# CORS — em producao defina origem real do frontend, ex: https://seu-dominio.com
CORS_ORIGINS=*
# Rate limit — tentativas por minuto em POST /auth/*
RATE_LIMIT_AUTH=10
