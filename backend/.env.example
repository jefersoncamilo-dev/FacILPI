# Copie para .env e preencha — nunca comite .env real

# OBRIGATORIA. Nao ha default: a aplicacao e o Alembic recusam iniciar sem ela.
# NUNCA aponte para ../storage/app.db nem para backend/storage/app.db — sao
# bancos historicos protegidos, parados em 006, e o guard de runtime os recusa.
# SQLite:     sqlite+aiosqlite:///./storage/pilot/facilpi.db
# PostgreSQL: postgresql+asyncpg://user:senha@host:5432/database?pgbouncer=true
DATABASE_URL=

# OBRIGATORIA. Segredo de assinatura das sessoes.
# Gere um valor aleatorio EXCLUSIVO deste ambiente, com 32+ bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A aplicacao recusa iniciar se estiver ausente, curta ou se for um dos valores
# de desenvolvimento que ja circularam neste repositorio.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

PORT=8000
STORAGE_PATH=./storage
# Arquivos anexados a Documentos. Diretorio dedicado, separado do banco:
# nunca aponte para a raiz que contem app.db.
UPLOAD_ROOT=./storage/uploads
# CORS — em producao defina a origem real do frontend, ex: https://seu-dominio.com
# `*` e recusado no codigo: cookies exigem credentials=true, incompativel com wildcard.
CORS_ORIGINS=http://localhost:5173
# Rate limit — tentativas por minuto em POST /auth/*
RATE_LIMIT_AUTH=10
